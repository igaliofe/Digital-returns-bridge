<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <context-param>
        <param-name>jakarta.faces.PROJECT_STAGE</param-name>
        <param-value>Production</param-value>
    </context-param>

    <!-- Cache compiled facelets indefinitely (Production also implies this, but
         set explicit so a stray Development override can't re-enable per-request
         re-parsing). -1 = never check xhtml for changes at runtime. -->
    <context-param>
        <param-name>jakarta.faces.FACELETS_REFRESH_PERIOD</param-name>
        <param-value>-1</param-value>
    </context-param>

    <!-- Mojarra defaults resource Cache-Control to max-age=604800 (a week), and
         h:outputStylesheet emits no version in the URL — so an edited drb.css keeps
         serving stale to anyone who loaded a page before the change. An hour still
         spares the ~490KB of PrimeFaces JS/CSS from re-downloading during a session,
         but a stylesheet fix reaches an existing browser the same day. -->
    <context-param>
        <param-name>com.sun.faces.defaultResourceMaxAge</param-name>
        <param-value>3600000</param-value>
    </context-param>

    <context-param>
        <param-name>primefaces.THEME</param-name>
        <param-value>saga</param-value>
    </context-param>

    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>login.xhtml</welcome-file>
    </welcome-file-list>

    <!-- Cookie-only sessions: drops ;jsessionid= from URLs so PrimeFaces CSS/JS
         (theme.css, jquery.js, components.js — ~490KB) become cacheable by the
         browser/CDN instead of re-downloading every navigation. -->
    <session-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

</web-app>
