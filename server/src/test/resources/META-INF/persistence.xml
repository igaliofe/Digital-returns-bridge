<?xml version="1.0" encoding="UTF-8"?>
<!--
    Test-only persistence unit. It lives in src/test/resources, so it is never packaged
    into the WAR and never shadows the real JTA unit in src/main/resources/META-INF
    (that one is named drbPU; this one is drbTestPU, and units are resolved by name).

    RESOURCE_LOCAL against H2 in PostgreSQL compatibility mode, so the concurrency test
    runs against a real database with real row locks and no application server.
-->
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence">
  <persistence-unit name="drbTestPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

    <class>com.drb.server.domain.Customer</class>
    <class>com.drb.server.domain.CustomerPurchase</class>
    <class>com.drb.server.domain.Driver</class>
    <class>com.drb.server.domain.PickupUpdate</class>
    <class>com.drb.server.domain.Product</class>
    <class>com.drb.server.domain.ReturnImage</class>
    <class>com.drb.server.domain.ReturnRequest</class>
    <class>com.drb.server.domain.StatusHistory</class>
    <class>com.drb.server.domain.User</class>
    <class>com.drb.server.domain.WarehouseInspection</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>

    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
      <property name="jakarta.persistence.jdbc.url"
                value="jdbc:h2:mem:drbtest;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1"/>
      <property name="jakarta.persistence.jdbc.user" value="sa"/>
      <property name="jakarta.persistence.jdbc.password" value=""/>

      <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
      <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
      <property name="hibernate.jpa.compliance.query" value="false"/>
      <property name="hibernate.show_sql" value="false"/>
      <!-- each racing thread must get its own physical connection -->
      <property name="hibernate.connection.pool_size" value="8"/>
      <property name="hibernate.connection.isolation" value="2"/>
    </properties>
  </persistence-unit>
</persistence>
