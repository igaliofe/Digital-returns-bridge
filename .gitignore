# ===== Gradle / Android =====
# gradle-wrapper.jar is deliberately committed — this re-include must stay AFTER the `*.jar`
# rule above (last match wins). Without the jar `./gradlew` cannot bootstrap, so a fresh
# clone could not build the Android app at all.
!android-driver-app/gradle/wrapper/gradle-wrapper.jar
.gradle/
build/
local.properties
*.apk
*.aab
*.ap_
*.dex
captures/
.externalNativeBuild/
.cxx/

# ===== Keystores / Secrets =====
*.jks
*.keystore
*.p12
*.pem
.env
.env.*
!.env.example

# ===== Misc / Temp =====
.figma-tmp/
