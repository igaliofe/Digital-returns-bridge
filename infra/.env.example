# PostgreSQL
POSTGRES_DB=drb
POSTGRES_USER=drb
POSTGRES_PASSWORD=change_me_in_production

# JDBC (used by WildFly datasource)
JDBC_URL=jdbc:postgresql://postgres:5432/drb

# Cloudinary — get from cloudinary.com dashboard
# REQUIRED for core flows, not optional. Image/signature handling now depends on
# Cloudinary: product catalog images, multi-image service documentation, and the
# drawn signatures for both the driver and the service rep. With the placeholder
# values left in, these uploads will fail at runtime and the affected flows
# (return creation, pickup confirmation, warehouse receiving) cannot complete.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# WildFly management console
WILDFLY_ADMIN_USER=admin
WILDFLY_ADMIN_PASSWORD=change_me_in_production
