<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DriverApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/drb_navy</item>
        <item name="colorPrimaryVariant">@color/drb_navy_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/drb_gold</item>
        <item name="colorSecondaryVariant">@color/drb_gold_muted</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/drb_navy</item>
        <item name="android:windowBackground">@color/drb_cream_bg</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="DrbText.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/drb_text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/drb_text_primary</item>
    </style>

    <style name="DrbText.Header" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/drb_text_header</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="DrbText.Subtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/drb_text_caption</item>
        <item name="android:textColor">@color/drb_text_secondary</item>
    </style>

    <style name="DrbText.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/drb_text_body</item>
        <item name="android:textColor">@color/drb_text_secondary</item>
    </style>

    <style name="DrbText.CardTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/drb_text_primary</item>
    </style>

    <style name="DrbText.CardDetail" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/drb_text_caption</item>
        <item name="android:textColor">@color/drb_text_secondary</item>
    </style>

    <style name="DrbText.Chip" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/drb_text_chip</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="DrbButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/drb_navy</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/drb_text_body</item>
        <item name="cornerRadius">@dimen/drb_radius_pill</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="DrbButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/drb_navy</item>
        <item name="strokeColor">@color/drb_border_warm</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/drb_radius_sm</item>
    </style>

    <style name="DrbCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/drb_radius_md</item>
        <item name="cardElevation">@dimen/drb_elevation_card</item>
        <item name="cardBackgroundColor">@color/drb_surface</item>
        <item name="contentPadding">@dimen/drb_card_padding</item>
    </style>

    <style name="DrbTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/drb_border_warm</item>
        <item name="boxCornerRadiusTopStart">@dimen/drb_radius_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/drb_radius_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/drb_radius_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/drb_radius_sm</item>
        <item name="android:textColorHint">@color/drb_gold</item>
    </style>
</resources>
