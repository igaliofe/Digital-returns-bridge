<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/drb_navy"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/drb_spacing_md"
    android:paddingEnd="@dimen/drb_header_padding_horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="@dimen/drb_header_padding_vertical">

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/DrbText.Header"/>

    <TextView
        android:id="@+id/tvHeaderAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/logout"
        android:textColor="@color/drb_text_header_muted"
        android:textSize="@dimen/drb_text_caption"
        android:padding="4dp"
        android:visibility="gone"/>
</LinearLayout>
